# ============================================
# Custom SMTP Configuration (recommended)
# Works with any provider or self-hosted server
# ============================================

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Sender identity
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Your Brand Name

# Optional: set to false if using self-signed certificates
# SMTP_REJECT_UNAUTHORIZED=false

# ============================================
# Legacy Gmail support (still works)
# ============================================
# GMAIL_USER=alonejamesowns@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
